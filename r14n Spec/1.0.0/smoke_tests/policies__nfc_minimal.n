// r14n smoke test — nfc / minimal (core-book instance form).
// NOT LEGAL ADVICE. strictness=minimal: only `legally_required` enforced. The floor
// keeps session_scoped so even minimal posture never permits ambient/unbounded tag polling.

mod packs {
  nfc_minimal: <PolicyPack> {
    id: "nfc"
    domain: "nfc"
    meta: {
      strictness: "minimal"
      description: "Least-restrictive floor — consent + usage description; every scan session-scoped, never ambient polling."
      legal_review: { status: "requires_signoff", counsel: "TBD" }
    }
    subjects: [
      { key: "read",           controls: ["consent_prompt", "usage_description"] },
      { key: "write",          controls: ["consent_prompt", "usage_description", "session_scoped"] },
      { key: "background_tag", controls: ["consent_prompt", "usage_description"] }
    ]
    legally_required: ["consent_prompt", "usage_description", "session_scoped"]
  }
}
