/resolver/target
/resolver/fuzz/target
/resolver/fuzz/corpus
/resolver/fuzz/artifacts
/tools/target
/target
# Ed25519 signing seeds are PRIVATE key material — never commit (council-audit fix).
*.seed
**/*.rs.bk
.DS_Store
# N Lang Snapp build artifacts (source + emitted snapp/ are committed; build cache is not)
**/.n/build/
**/.n/wal/
**/.n/deps/
**/.n/dist/

# wrangler local state for the site Worker (deploy artifacts, never source)
site/.wrangler/

# Binding build output. The wasm/wheel artifacts are GENERATED from resolver/
# on every release (CONTRIBUTING.md bindings policy) — never source, never
# committed, so a stale copy can't drift from the core.
/bindings/wasm/target
/bindings/python/target
/dist
__pycache__/
*.py[cod]

# N Lang build output outside .n/ (plugin_cache.json embeds local absolute
# paths to sibling private repos — regenerable, never source).
r14n Spec/*/build/
baselines/*/build/
