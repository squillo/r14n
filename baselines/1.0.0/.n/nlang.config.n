{
  "name": "r14n_baselines",
  "edition": "2026",
  "version": "1.0.0",
  "description": "Squillo's own r14n regulatory-policy baseline packs (aggressive/minimal) — a consumer Snapp that @deps the r14n framework. NOT LEGAL ADVICE.",
  "author": "Scott Wyatt <legal@squillo.com>",
  "authors": [],
  "license": "SEE LICENSE IN LICENSE",
  "tags": [],
  "framework": "n",
  "src_dir": "../",
  "dep_dir": "./.n/deps",
  "build_dir": "./.n/build",
  "out_dir": "../../snapp",
  "wal_dir": "./.n/wal",
  "repository": null,
  "homepage": null,
  "documentation": null,
  "keywords": [],
  "categories": [],
  "main": null,
  "lib_entry": null,
  "target": null,
  "incremental": true,
  "deps": [],
  "dev_deps": [],
  "features": {},
  "channel": null,
  "lens_gate": null,
  "allowed_file_types": [
    "n.md",
    "n",
    "nbin",
    "json"
  ],
  "exclude": [
    ".n/*",
    ".nde/*",
    ".git/*",
    "node_modules/*",
    "how/*"
  ],
  "export": [
    "$"
  ],
  "start": [],
  "log_level": "info",
  "strict": false,
  "pretty": true,
  "indent": 2,
  "optimize_level": 0,
  "emit_snapp": true,
  "emit_deps": true,
  "emit_env": true,
  "emit_tests": true,
  "emit_blocks": true,
  "emit_meta_blocks": false,
  "emit_metadata": true,
  "emit_types": false,
  "emit_inferred": true,
  "emit_vars": false,
  "emit_derived": false,
  "emit_nodes": true,
  "emit_mod": true,
  "emit_links": false,
  "emit_dir_labels": false,
  "emit_temp_labels": false,
  "allow": [],
  "prelude": true,
  "standard": true,
  "skip_linting": false,
  "lint_allow": [],
  "lint_deny": [],
  "lint_warn": [],
  "permissions": {
    "fs_read": true,
    "fs_write": true,
    "network": false
  }
}
