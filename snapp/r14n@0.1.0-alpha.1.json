        "blocks": {
          "pub": {
            "PolicyPack": {
              "atom": "list",
              "description": "{PolicyPack} Object Block — one (profile × domain) control-prescription",
              "props": {
                "id": {
                  "atom": "str",
                  "format": "^[a-z][a-z0-9_]{0,63}$",
                  "priority": 1
                },
                "domain": {
                  "atom": "str",
                  "description": "Capability family this pack governs (e.g. health, smart_home, nfc)",
                  "format": "^[a-z][a-z0-9_]{0,63}$",
                  "priority": 2
                },
                "strictness": {
                  "atom": "str",
                  "default": "aggressive",
                  "value": [
                    "aggressive",
                    "as_configured",
                    "minimal"
                  ],
                  "priority": 3
                },
                "summary": {
                  "atom": "str",
                  "description": "Human-readable pack description",
                  "optional": true,
                  "priority": 4
                },
                "legal_review_status": {
                  "atom": "str",
                  "default": "not_required",
                  "value": [
                    "draft",
                    "requires_signoff",
