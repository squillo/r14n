  "@deps": {
    "r14n": {
      "use": {
        "$::*": {}
      },
      "from": "../../snapp/r14n@0.1.0-alpha.1.json",
      "integrity": "sha256-38b50faca609b73945041b2b060ae8372e1aaba74250f19c1a8fa45a87159358"
    }
  },
  "policies": {
    "HEALTH_AGGRESSIVE": {
      "domain": "health",
      "strictness": "aggressive",
      "summary": "Fail-closed baseline — the full HealthKit control universe.",
      "subjects": {
        "read": {
          "controls": [
            "consent_prompt",
            "usage_description",
            "on_device_only",
            "read_scope_limit"
          ]
        },
        "write": {
          "controls": [
            "consent_prompt",
            "usage_description",
            "on_device_only",
            "audit_log"
          ]
        }
      },
      "legally_required": [
        "consent_prompt",
        "usage_description",
        "on_device_only",
        "read_scope_limit",
        "audit_log"
      ]
    },
    "RECORDING_CONSENT_AGGRESSIVE": {
      "domain": "recording_consent",
      "strictness": "aggressive",
      "summary": "Fail-closed baseline — the full per-rail control universe, every jurisdiction.",
      "subjects": {
        "local_piggyback": {
          "controls": [
            "attestation",
            "aph_mandate_principal_signed"
          ]
        },
        "telepresence": {
          "controls": [
            "signal_notice",
            "indicator_mount",
            "aph_mandate_principal_signed"
          ]
        },
        "twin_attend": {
          "controls": [
            "announcement",
            "aph_mandate_principal_signed"
          ]
        },
        "import": {
          "controls": [
            "attestation",
            "aph_mandate_principal_signed"
          ]
        }
      },
      "legally_required": [
        "attestation",
        "signal_notice",
        "indicator_mount",
        "announcement",
        "aph_mandate_principal_signed"
      ]
    },
    "RECORDING_CONSENT_MINIMAL": {
      "domain": "recording_consent",
      "strictness": "minimal",
      "summary": "Least-restrictive floor — only legally-required controls are enforced.",
      "legal_review_status": "requires_signoff",
      "legal_review_counsel": "TBD",
      "subjects": {
        "local_piggyback": {
          "controls": [
            "attestation"
          ]
        },
        "telepresence": {
          "controls": [
            "signal_notice"
          ]
        },
        "twin_attend": {
          "controls": [
            "announcement"
          ]
        },
        "import": {
          "controls": [
            "attestation"
          ]
        }
      },
      "legally_required": [
        "attestation"
      ]
    }
  },
  "mod": {
    "@deps": {
      "blocks": {
        "r14n": {
          "blocks": {
            "policies": {
              "atom": "list",
              "description": "{Policies} Object Block — regulatory policy pack ledger",
              "blocks": {
                "*": {
                  "type": "<$::@deps::r14n::*::PolicyPack>",
                  "optional": true
                }
              }
            }
          },
          "mod": {
            "*": {
              "blocks": {
                "PolicyPack": {
                  "atom": "list",
                  "description": "{PolicyPack} Object Block — one (profile × domain) control-prescription",
                  "props": {
                    "id": {
                      "atom": "str",
                      "format": "^[a-z][a-z0-9_]{0,63}$",
                      "priority": 1
                    },
                    "domain": {
                      "atom": "str",
                      "description": "Capability family this pack governs (e.g. health, smart_home, nfc)",
                      "format": "^[a-z][a-z0-9_]{0,63}$",
                      "priority": 2
                    },
                    "strictness": {
                      "atom": "str",
                      "default": "aggressive",
                      "values": [
                        "aggressive",
                        "as_configured",
                        "minimal"
                      ],
                      "priority": 3
                    },
                    "summary": {
                      "atom": "str",
                      "description": "Human-readable pack description",
                      "optional": true,
                      "priority": 4
                    },
                    "legal_review_status": {
                      "atom": "str",
                      "default": "not_required",
                      "values": [
                        "draft",
                        "requires_signoff",
                        "not_required"
                      ],
                      "priority": 5
                    },
                    "legal_review_counsel": {
                      "atom": "str",
                      "description": "Reviewing counsel of record (\\\\\\\"TBD\\\\\\\" until assigned); REQUIRED before a real-jurisdiction pack ships",
                      "optional": true,
                      "priority": 6
                    },
                    "subjects": {
                      "atom": "list",
                      "description": "Per-subject required-control table (list of {key, controls} rows)",
                      "items": {
                        "type": "<$::@deps::r14n::*::Subject>"
                      },
                      "min_items": 1,
                      "priority": 7
                    },
                    "legally_required": {
                      "atom": "list",
                      "description": "Controls required under minimal strictness / when no subject row matches",
                      "items": {
                        "atom": "str"
                      },
                      "priority": 8
                    },
                    "prohibited": {
                      "atom": "list",
                      "description": "Controls this profile FORBIDS — the data-minimization guard input: no posture may ADD a control listed here, and a resolver subtracts it from every resolved set. MUST NOT intersect legally_required (a pack that both requires and forbids a control is not satisfiable). OPTIONAL: an absent list forbids nothing, which is why it is not the same as an empty one in review.",
                      "items": {
                        "atom": "str"
                      },
                      "optional": true,
                      "priority": 9
                    }
                  }
                },
                "Subject": {
                  "atom": "list",
                  "description": "{Subject} Object Block — one capability facet and its required controls",
                  "props": {
                    "key": {
                      "atom": "str",
                      "description": "Gate subject key (capability facet: read, write, control, enumerate, …)",
                      "format": "^[a-z][a-z0-9_]{0,63}$"
                    },
                    "controls": {
                      "atom": "list",
                      "description": "Required opaque control keys for this subject (the gate owns polarity)",
                      "items": {
                        "atom": "str"
                      },
                      "min_items": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}